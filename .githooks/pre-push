#!/bin/sh
set -eu

allowed='acursour@gmail.com'
actual="$(git config --get user.email || true)"
if [ "$actual" != "$allowed" ]; then
  echo "ERROR: pushes require user.email=$allowed (got: ${actual:-<unset>})" >&2
  exit 1
fi

bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  for email in $(git log --format='%ae' "$range"); do
    if [ "$email" != "$allowed" ]; then
      echo "ERROR: refusing push; outgoing commit has unapproved author email: $email" >&2
      bad=1
    fi
  done
done
if [ "$bad" -ne 0 ]; then exit 1; fi
