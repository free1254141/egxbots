# Historical price archive (private Hugging Face Dataset, optional but recommended)
# Do not point this at the public Space repository; market-data licensing and
# the Space filesystem make that unsuitable for persistent history.
HF_HISTORY_DATASET_REPO=weeasdwee/egx-historical-prices
HF_HISTORY_LIVE_TAIL_DAYS=45
HF_HISTORY_REBASE_DAYS=30

# Required only for the first seed and monthly Dataset rebase when the Dataset
# is private. Store as a Hugging Face Space secret in production.
HF_TOKEN=

# AI Chat & Decision Engines (Never commit real keys; set in .env / web/.env.local / Vercel / HF Secrets)
DEEPSEEK_API_KEY=
DEEPSEEK_OFFICIAL_API_KEY=
EXPERIENTIAL_API_KEY=
EXPLABS_API_KEY=
NVIDIA_API_KEY=
NVIDIA_SECONDARY_API_KEY=

# Telegram VIP Chat Room & Topic (https://t.me/egxbots/1680)
TELEGRAM_VIP_CHAT_ID=-1002083067817
TELEGRAM_VIP_CHAT_THREAD_ID=1680

# Resend Email Lifecycle & Recovery (Free tier up to 3,000/mo)
RESEND_API_KEY=
MARKETING_EMAIL_FROM=EGX Bots <support@egxbots.com>
MARKETING_DAILY_EMAIL_CAP=90

